# Fizz App Environment Variables
NEXT_PUBLIC_APP_NAME=Fizz
NEXT_PUBLIC_APP_URL=https://fizz.shotonme.com

# Backend API (same as Shot On Me)
NEXT_PUBLIC_API_URL=https://shot-on-me.onrender.com/api

# Google Maps (same key as Shot On Me)
